{
  "name": "blockflow-vscode",
  "displayName": "Blockflow",
  "description": "Open and edit .blockflow project files and .sb3 Scratch projects in VS Code",
  "version": "0.1.0",
  "publisher": "openpatch",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpatch/blockflow.git",
    "directory": "platforms/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "blockflow.blockflowEditor",
        "displayName": "Blockflow Editor",
        "selector": [
          {
            "filenamePattern": "*.blockflow"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "blockflow.sb3Editor",
        "displayName": "Scratch Editor",
        "selector": [
          {
            "filenamePattern": "*.sb3"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "vsce package",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "mini-css-extract-plugin": "^2.9.2",
    "style-loader": "^3.3.3",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "file-loader": "^6.2.0",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "html-webpack-plugin": "^5.6.0",
    "copy-webpack-plugin": "^12.0.2"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
